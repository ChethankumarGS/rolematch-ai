# Postgres connection string (Neon, Supabase, or local docker-compose).
# On Vercel this is injected automatically when you connect a Postgres store.
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/rolematch

# LLM provider: gemini (default, free tier) or openai (bring your own key)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
CHAT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# OpenAI path (optional): set LLM_PROVIDER=openai and fill these.
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Secret that protects the admin seed endpoint. Any random string.
SEED_SECRET=change-me
